{
  "manifest_version": 2,
  "name": "Calipers — Measure & Inspect Web Pages",
  "version": "0.1.1",
  "description": "Measure pixel distances, inspect element sizes, and check alignment on any webpage. Free, open source.",
  "author": "Calipers Contributors",

  "browser_specific_settings": {
    "gecko": {
      "id": "calipers@calipers.dev",
      "strict_min_version": "109.0"
    }
  },

  "icons": {
    "16":  "assets/icons/icon-16.png",
    "32":  "assets/icons/icon-32.png",
    "48":  "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },

  "browser_action": {
    "default_icon": {
      "16":  "assets/icons/icon-16.png",
      "32":  "assets/icons/icon-32.png",
      "48":  "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    },
    "default_title": "Calipers"
  },

  "background": {
    "scripts": ["dist-ff/background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist-ff/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "<all_urls>"
  ],

  "commands": {
    "toggle-calipers": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Toggle Calipers on/off"
    }
  },

  "web_accessible_resources": [
    "assets/*",
    "assets/fonts/*"
  ]
}
